---
import Layout from '../layouts/Layout.astro';
import publications from '../data/publications.json';

const byYear: Record<number, (typeof publications)[number][]> = {};
for (const p of publications) {
  (byYear[p.year] ||= []).push(p);
}
const years = Object.keys(byYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<Layout title="Publications" description="Selected publications from the Nelson Lab.">
  <h1 class="mb-8 text-3xl font-bold text-slate-900">Publications</h1>

  <div class="prose">
    {
      years.map((year) => (
        <section class="mb-8">
          <h2 class="mb-4 text-xl font-semibold text-indigo-700">{year}</h2>
          {byYear[year].map((p) => (
            <p>
              <span set:html={p.citation} />
              {p.pdf && (
                <a
                  href={p.pdf}
                  target="_blank"
                  class="ml-2 inline-block rounded bg-indigo-100 px-2 py-1 text-xs font-medium text-indigo-700 hover:bg-indigo-200"
                >
                  PDF
                </a>
              )}
            </p>
          ))}
        </section>
      ))
    }
  </div>
</Layout>
